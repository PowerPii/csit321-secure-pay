{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.securepay.local/events/payment.expired.schema.json",
  "title": "payment.expired",
  "description": "The checkout session ended after 1 hour without a card submission. No charge.",
  "allOf": [
    {
      "$ref": "../schemas/event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "payment.expired"
        },
        "data": {
          "type": "object",
          "properties": {
            "object": {
              "$ref": "../schemas/payment.schema.json",
              "properties": {
                "status": {
                  "const": "expired"
                }
              }
            }
          }
        }
      }
    }
  ]
}
