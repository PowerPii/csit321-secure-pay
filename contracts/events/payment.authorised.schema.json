{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.securepay.local/events/payment.authorised.schema.json",
  "title": "payment.authorised",
  "description": "The simulated bank authorised the payment. Capture it with POST /v1/payments/{id}/capture once you decide to fulfil; it is cancelled automatically after 7 days if not captured.",
  "allOf": [
    {
      "$ref": "../schemas/event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "payment.authorised"
        },
        "data": {
          "type": "object",
          "properties": {
            "object": {
              "$ref": "../schemas/payment.schema.json",
              "properties": {
                "status": {
                  "const": "authorised"
                }
              }
            }
          }
        }
      }
    }
  ]
}
