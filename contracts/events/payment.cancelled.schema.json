    {
      "$ref": "../schemas/event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "payment.cancelled"
        },
        "data": {
          "type": "object",
          "properties": {
            "object": {
              "$ref": "../schemas/payment.schema.json",
              "properties": {
                "status": {
                  "const": "cancelled"
                }
              }
            }
          }
        }
      }
    }
  ]
}
