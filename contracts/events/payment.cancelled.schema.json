{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.securepay.local/events/payment.cancelled.schema.json",
  "title": "payment.cancelled",
  "description": "The authorisation was voided by the merchant (outcome.reason merchant_cancelled) or after 7 days uncaptured (authorisation_expired). No charge.",
